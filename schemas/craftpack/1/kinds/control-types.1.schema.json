{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://glyphcore.github.io/Strudel-craft/schemas/craftpack/1/kinds/control-types.1.schema.json",
 "title": "control-types@1",
 "description": "control type declarations; optional renderer modules",
 "type": "object",
 "required": [
  "types"
 ],
 "additionalProperties": false,
 "properties": {
  "version": {
   "type": "integer"
  },
  "types": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "value"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
     },
     "value": {
      "enum": [
       "number",
       "bool",
       "enum",
       "vec2",
       "vec3",
       "vec4",
       "array",
       "notes",
       "breakpoints",
       "readonly"
      ]
     },
     "keys": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "render": {
      "type": "object",
      "properties": {
       "fallback": {
        "type": "string"
       },
       "minSize": {
        "type": "number"
       }
      }
     },
     "drawn": {
      "type": "boolean"
     },
     "input": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "renderer": {
      "type": "string",
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)[^\\x00-\\x1f]+$",
      "maxLength": 512,
      "description": "module path; must be listed in the ingredient's `modules`"
     }
    }
   }
  }
 }
}
