{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://glyphcore.github.io/Strudel-craft/schemas/craftpack/1/kinds/layouts.1.schema.json",
 "title": "layouts@1",
 "description": "workspace layouts",
 "type": "object",
 "required": [
  "layouts"
 ],
 "additionalProperties": false,
 "properties": {
  "layouts": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "rows"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
     },
     "title": {
      "type": "string",
      "maxLength": 40
     },
     "key": {
      "type": "string",
      "description": "suggested hotkey; applied only if free, never over a user or core binding"
     },
     "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "id"
        ],
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string",
          "description": "pane id known to the host (editor, graph, recipes, perform, syntax, history, tracker, ...); unknown panes are dropped"
         },
         "w": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "collapsed": {
          "type": "boolean"
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
