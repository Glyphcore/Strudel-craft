{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://glyphcore.github.io/Strudel-craft/schemas/craftpack/1/kinds/palette-actions.1.schema.json",
 "title": "palette-actions@1",
 "description": "command palette actions; declarative ops are data, run modules are code",
 "type": "object",
 "required": [
  "actions"
 ],
 "additionalProperties": false,
 "properties": {
  "actions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title"
    ],
    "additionalProperties": false,
    "oneOf": [
     {
      "required": [
       "do"
      ]
     },
     {
      "required": [
       "run"
      ]
     }
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
     },
     "title": {
      "type": "string",
      "maxLength": 80
     },
     "group": {
      "type": "string"
     },
     "keys": {
      "type": "string",
      "description": "suggested chord; applied only if free"
     },
     "do": {
      "type": "object",
      "required": [
       "op"
      ],
      "additionalProperties": false,
      "properties": {
       "op": {
        "enum": [
         "view",
         "layout",
         "recipe.load",
         "recipe.play",
         "insert",
         "bank.activate",
         "pack.load",
         "transport",
         "open-url"
        ]
       },
       "args": {
        "type": "object"
       }
      },
      "description": "declarative host op (data); open-url is https only and asks first"
     },
     "run": {
      "type": "string",
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)[^\\x00-\\x1f]+$",
      "maxLength": 512,
      "description": "module whose default export runs in the sandbox and may return a list of declarative ops"
     }
    }
   }
  }
 }
}
