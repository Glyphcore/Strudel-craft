{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://glyphcore.github.io/Strudel-craft/schemas/craftpack/1/kinds/recipes.1.schema.json",
 "title": "recipes@1",
 "description": "catalog recipes with categories and labels (program text, run only on a user gesture)",
 "type": "object",
 "required": [
  "recipes"
 ],
 "additionalProperties": false,
 "properties": {
  "version": {
   "type": "integer"
  },
  "strudel_web": {
   "type": "string"
  },
  "url_format": {
   "type": "string"
  },
  "url_format_verified": {
   "type": "string"
  },
  "categories": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    }
   }
  },
  "labels": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "category": {
      "type": "string"
     },
     "words": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "recipes": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/recipe"
   }
  }
 },
 "$defs": {
  "recipe": {
   "type": "object",
   "required": [
    "id",
    "title",
    "code"
   ],
   "additionalProperties": false,
   "patternProperties": {
    "^x-": {}
   },
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "title": {
     "type": "string",
     "maxLength": 80
    },
    "intent": {
     "type": "string"
    },
    "code": {
     "type": "string",
     "maxLength": 20000,
     "description": "Program text in the authored Craft form (the source of truth); evaluated only on a user gesture"
    },
    "expr": {
     "type": [
      "string",
      "null"
     ]
    },
    "notes": {
     "type": "string"
    },
    "labels": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "source": {
     "type": "string"
    },
    "origin": {
     "type": "string"
    },
    "unverified": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "needs_samples": {
     "type": "boolean"
    },
    "needs": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?:[a-z0-9][a-z0-9._-]{0,63}$"
     },
     "description": "ingredients (sound maps, vox banks, hooks) the recipe needs loaded"
    },
    "bpm_hint": {
     "type": [
      "number",
      "null"
     ]
    },
    "verified": {
     "type": "boolean"
    },
    "rms_dbfs": {
     "type": [
      "number",
      "null"
     ]
    },
    "centroid_hz": {
     "type": [
      "number",
      "null"
     ]
    },
    "peak": {
     "type": [
      "number",
      "null"
     ]
    },
    "error": {
     "type": [
      "string",
      "null"
     ]
    },
    "lowered": {
     "type": "string",
     "maxLength": 20000,
     "description": "the plain Strudel form of `code` (atoms, hooks and grooves written out; what strudel.cc needs). Present only when it differs from `code`; generated by tools/lowering, never hand-kept"
    },
    "lowered_note": {
     "type": "string",
     "description": "why `code` has no plain Strudel form (it needs the Craft runtime); present instead of `lowered`"
    },
    "lowered_check": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "equal": {
       "type": "boolean"
      },
      "approx": {
       "type": "boolean"
      },
      "cycles": {
       "type": "integer"
      },
      "events": {
       "type": "integer"
      },
      "reason": {
       "type": "string"
      },
      "hash": {
       "type": "string"
      }
     },
     "description": "build-time hap equality of `code` and `lowered` (strudel events over `cycles` cycles)"
    },
    "family": {
     "type": "string",
     "description": "concept family the recipe was generated from (tools/concepts)"
    },
    "folder": {
     "type": "string",
     "maxLength": 80,
     "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*){0,7}$",
     "description": "slash path in the pack's folder tree, lowercase segments, e.g. hiphop/trap/drums (PACK_SPEC 5.3)"
    },
    "tags": {
     "type": "array",
     "maxItems": 24,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
     },
     "description": "lowercase kebab tags; the pack's taxonomy.tags is the controlled vocabulary, other tags are allowed and warn (W_PACK_TAG)"
    },
    "aliases": {
     "type": "array",
     "maxItems": 16,
     "items": {
      "type": "string"
     },
     "description": "older ids or names of this item: a bare reference to an alias resolves to this item (PACK_SPEC 9.3 rule 5)"
    }
   }
  }
 }
}
