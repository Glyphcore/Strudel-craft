{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://glyphcore.github.io/Strudel-craft/schemas/craftpack/1/kinds/sample-source.1.schema.json",
 "title": "sample-source@1",
 "description": "remote sample sources referenced by URL; no audio bytes in the pack. A source has either index_url (a remote map) or map + base (an inline map of remote files). license may be 'unknown' (shown flagged).",
 "type": "object",
 "required": [
  "sources"
 ],
 "additionalProperties": false,
 "properties": {
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "sounds",
     "license",
     "terms_url"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
     },
     "title": {
      "type": "string"
     },
     "index_url": {
      "type": "string",
      "pattern": "^https://",
      "description": "a remote strudel.json-shaped map (alternative to map + base)"
     },
     "sounds": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_.#-]+$"
      },
      "description": "bare sound names this source registers; a program using one triggers the source's load"
     },
     "license": {
      "type": "string",
      "description": "SPDX id, LicenseRef-<id>, or 'unknown' (flagged in the UI)"
     },
     "attribution": {
      "type": "object",
      "required": [
       "name"
      ],
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string"
       },
       "url": {
        "type": "string"
       },
       "text": {
        "type": "string"
       },
       "changes": {
        "type": "string"
       }
      }
     },
     "terms_url": {
      "type": "string",
      "pattern": "^https://"
     },
     "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "cors": {
        "type": "boolean"
       },
       "stable": {
        "type": "boolean"
       },
       "checked": {
        "type": "string"
       },
       "status": {
        "type": "integer"
       }
      }
     },
     "map": {
      "type": "object",
      "minProperties": 1,
      "description": "inline strudel.json-shaped map (key -> files, or key -> {note: files}); file paths are relative to `base`. Used instead of index_url when the upstream has no map of its own; the audio stays remote"
     },
     "base": {
      "type": "string",
      "pattern": "^https://",
      "description": "absolute https folder the files of `map` live in (pin it to a commit)"
     }
    },
    "oneOf": [
     {
      "required": [
       "index_url"
      ],
      "not": {
       "anyOf": [
        {
         "required": [
          "map"
         ]
        },
        {
         "required": [
          "base"
         ]
        }
       ]
      }
     },
     {
      "required": [
       "map",
       "base"
      ],
      "not": {
       "required": [
        "index_url"
       ]
      }
     }
    ]
   }
  }
 }
}