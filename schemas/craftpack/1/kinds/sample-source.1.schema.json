{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://glyphcore.github.io/Strudel-craft/schemas/craftpack/1/kinds/sample-source.1.schema.json",
 "title": "sample-source@1",
 "description": "remote sample sources referenced by URL; no audio bytes in the pack. license may be 'unknown' (shown flagged). index_url is a strudel.json-shaped map (key -> files, optional _base).",
 "type": "object",
 "required": [
  "sources"
 ],
 "additionalProperties": false,
 "properties": {
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "index_url",
     "sounds",
     "license",
     "terms_url"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
     },
     "title": {
      "type": "string"
     },
     "index_url": {
      "type": "string",
      "pattern": "^https://"
     },
     "sounds": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_.#-]+$"
      },
      "description": "bare sound names this source registers; a program using one triggers the source's load"
     },
     "license": {
      "type": "string",
      "description": "SPDX id, LicenseRef-<id>, or 'unknown' (flagged in the UI)"
     },
     "attribution": {
      "type": "object",
      "required": [
       "name"
      ],
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string"
       },
       "url": {
        "type": "string"
       },
       "text": {
        "type": "string"
       },
       "changes": {
        "type": "string"
       }
      }
     },
     "terms_url": {
      "type": "string",
      "pattern": "^https://"
     },
     "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "cors": {
        "type": "boolean"
       },
       "stable": {
        "type": "boolean"
       },
       "checked": {
        "type": "string"
       },
       "status": {
        "type": "integer"
       }
      }
     }
    }
   }
  }
 }
}