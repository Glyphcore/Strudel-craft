{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://glyphcore.github.io/Strudel-craft/schemas/craftpack/1/kinds/sounds.1.schema.json",
 "title": "sounds@1",
 "description": "strudel.json-compatible sound map; keys are sound names, values are file lists or note->file maps",
 "type": "object",
 "minProperties": 1,
 "properties": {
  "_base": {
   "type": "string",
   "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)[^\\x00-\\x1f]+$",
   "maxLength": 512,
   "description": "optional base folder, relative to the entry file; absolute URLs are not allowed in a pack"
  }
 },
 "additionalProperties": {
  "oneOf": [
   {
    "type": "array",
    "minItems": 1,
    "items": {
     "type": "string",
     "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)[^\\x00-\\x1f]+$",
     "maxLength": 512
    }
   },
   {
    "type": "object",
    "minProperties": 1,
    "propertyNames": {
     "pattern": "^[a-gA-G][#bs]?-?\\d$"
    },
    "additionalProperties": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)[^\\x00-\\x1f]+$",
      "maxLength": 512
     }
    }
   }
  ]
 },
 "propertyNames": {
  "pattern": "^(_base|[A-Za-z0-9][A-Za-z0-9_]*)$",
  "description": "mini-notation-safe sound names"
 },
 "$defs": {
  "options": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "prefix": {
     "type": "string",
     "pattern": "^[A-Za-z0-9]+_$",
     "description": "prefix every key shares, if any (shown in the browser, used for collision reports)"
    },
    "tag": {
     "type": "string",
     "description": "superdough soundMap tag, default the pack id"
    }
   }
  }
 }
}
