{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://glyphcore.github.io/Strudel-craft/schemas/craftpack/1/kinds/syntax.1.schema.json",
 "title": "syntax@1",
 "description": "syntax lessons with runnable examples (program text)",
 "type": "object",
 "required": [
  "sections"
 ],
 "additionalProperties": false,
 "properties": {
  "version": {
   "type": "integer"
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "sections": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "examples"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
     },
     "title": {
      "type": "string"
     },
     "needs": {
      "type": "string",
      "description": "engine feature probed at runtime; absent feature = section marked coming"
     },
     "explain": {
      "type": "string"
     },
     "examples": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "title"
       ],
       "additionalProperties": false,
       "properties": {
        "title": {
         "type": "string"
        },
        "code": {
         "type": "string",
         "maxLength": 20000,
         "description": "program text in the authored Craft form"
        },
        "coming": {
         "type": "boolean"
        },
        "action": {
         "type": "string"
        },
        "noplay": {
         "type": "boolean"
        },
        "explain": {
         "type": "string"
        },
        "flow": {
         "type": "array",
         "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
           "type": "string"
          }
         }
        },
        "lowered": {
         "type": "string",
         "maxLength": 20000,
         "description": "the plain Strudel form of `code`, present only when it differs; generated by tools/lowering"
        },
        "lowered_note": {
         "type": "string",
         "description": "why `code` has no plain Strudel form (it needs the Craft runtime)"
        },
        "lowered_check": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "equal": {
           "type": "boolean"
          },
          "approx": {
           "type": "boolean"
          },
          "cycles": {
           "type": "integer"
          },
          "events": {
           "type": "integer"
          },
          "reason": {
           "type": "string"
          },
          "hash": {
           "type": "string"
          }
         },
         "description": "build-time hap equality of `code` and `lowered` (strudel events over `cycles` cycles)"
        },
        "smoke": {
         "type": "object",
         "additionalProperties": false,
         "description": "build-time smoke run of `code` when it has no plain form (strudel events over `cycles` cycles)",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "cycles": {
           "type": "integer"
          },
          "events": {
           "type": "integer"
          },
          "error": {
           "type": "string"
          },
          "hash": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "folder": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*){0,7}$",
      "description": "organizer folder (#120); default syntax/<needs>"
     },
     "tags": {
      "type": "array",
      "maxItems": 24,
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "description": "organizer tags (#120); default syntax, <needs>, built|coming"
     },
     "notes": {
      "type": "array",
      "description": "labelled notes under the section text: [label, text or list of texts]",
      "items": {
       "type": "array",
       "minItems": 2,
       "maxItems": 2,
       "prefixItems": [
        {
         "type": "string"
        },
        {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "array",
           "items": {
            "type": "string"
           }
          }
         ]
        }
       ]
      }
     },
     "tool": {
      "type": [
       "string",
       "null"
      ],
      "description": "the suno-track-lab engine/composer subcommand that measures this concept"
     }
    }
   }
  },
  "title": {
   "type": "string"
  },
  "doc": {
   "type": "string",
   "description": "the doc this data is generated with (docs/COMPOSITION.md)"
  },
  "licence": {
   "type": "string"
  },
  "families": {
   "type": "array",
   "description": "concept families (composition catalog): id, title, folder, intro",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "title"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "folder": {
      "type": "string"
     },
     "intro": {
      "type": "string"
     }
    }
   }
  }
 }
}
