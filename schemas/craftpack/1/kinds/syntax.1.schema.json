{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://glyphcore.github.io/Strudel-craft/schemas/craftpack/1/kinds/syntax.1.schema.json",
 "title": "syntax@1",
 "description": "syntax lessons with runnable examples (program text)",
 "type": "object",
 "required": [
  "sections"
 ],
 "additionalProperties": false,
 "properties": {
  "version": {
   "type": "integer"
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "sections": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "examples"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
     },
     "title": {
      "type": "string"
     },
     "needs": {
      "type": "string",
      "description": "engine feature probed at runtime; absent feature = section marked coming"
     },
     "explain": {
      "type": "string"
     },
     "examples": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "title"
       ],
       "additionalProperties": false,
       "properties": {
        "title": {
         "type": "string"
        },
        "code": {
         "type": "string",
         "maxLength": 20000
        },
        "coming": {
         "type": "boolean"
        },
        "action": {
         "type": "string"
        },
        "noplay": {
         "type": "boolean"
        },
        "explain": {
         "type": "string"
        },
        "flow": {
         "type": "array",
         "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
