{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://glyphcore.github.io/Strudel-craft/schemas/craftpack/1/kinds/vox-bank.1.schema.json",
 "title": "vox-bank@1",
 "description": "word/syllable vocal bank: sound maps (flat + pitched) plus words metadata",
 "type": "object",
 "required": [
  "prefix",
  "maps"
 ],
 "additionalProperties": false,
 "properties": {
  "prefix": {
   "type": "string",
   "pattern": "^[a-z0-9]+$",
   "description": "key prefix without underscore: keys are <prefix>_<word>, <prefix>_<word>_s<k>, <prefix>_syl"
  },
  "maps": {
   "type": "object",
   "required": [
    "flat"
   ],
   "additionalProperties": false,
   "properties": {
    "flat": {
     "type": "string",
     "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)[^\\x00-\\x1f]+$",
     "maxLength": 512,
     "description": "sounds@1 map at natural pitch"
    },
    "pitched": {
     "type": "string",
     "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)[^\\x00-\\x1f]+$",
     "maxLength": 512,
     "description": "sounds@1 map keyed by note, for .note() retuning"
    }
   }
  },
  "words": {
   "type": "string",
   "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)[^\\x00-\\x1f]+$",
   "maxLength": 512,
   "description": "vox-bank.words@1 file; omit for banks without word() support (sustained vowels)"
  },
  "sr": {
   "type": "integer",
   "minimum": 8000
  },
  "language": {
   "type": "string",
   "description": "BCP 47"
  },
  "voice": {
   "enum": [
    "speech",
    "sung",
    "synth"
   ]
  },
  "fallback": {
   "type": "string",
   "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?:[a-z0-9][a-z0-9._-]{0,63}$",
   "description": "bank searched for keys this one lacks"
  },
  "readme": {
   "type": "string",
   "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\)[^\\x00-\\x1f]+$",
   "maxLength": 512
  }
 }
}
