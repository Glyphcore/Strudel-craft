{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://glyphcore.github.io/Strudel-craft/schemas/craftpack/1/kinds/waveforms.1.schema.json",
 "title": "waveforms@1",
 "description": "drawn and computed instruments (docs/DRAWN_WAVEFORMS.md). Control points and parameters only, no audio. Closed world: every object lists its fields and sets additionalProperties false; every array, string and key has a length cap; every free string must match $defs/safe (printable ASCII only, so no zero-width or fullwidth look-alikes; no data:, blob:, ://, base64 in any case, RIFF/RIFX as written); map keys match a short name pattern. With these caps a schema-valid file is at most about 3.3 MB with 20-character numbers (32 instruments, about 5300 numbers each; measured 3.3 MB with 20-character numbers by tests/site/waveforms_caps.mjs), under the 5 MB entry-file limit (PACK_SPEC 10.2); a schema cannot count bytes, so validate() also checks the 5 MB size directly. site/engine/waveforms.js validate() enforces the same rules and is the check the site trusts (plus the one cross-field rule a schema cannot state: a param default lies within its min..max); tests/site/waveforms_caps.mjs runs both over the same bypass fixtures.",
 "type": "object",
 "required": ["instruments"],
 "additionalProperties": false,
 "properties": {
  "instruments": {
   "type": "array",
   "maxItems": 32,
   "items": {
    "type": "object",
    "required": ["id", "family", "origin", "license"],
    "anyOf": [{"required": ["cycle"]}, {"required": ["morph"]}],
    "additionalProperties": false,
    "properties": {
     "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"},
     "title": {"$ref": "#/$defs/safe80"},
     "family": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"},
     "origin": {"enum": ["drawn", "computed"]},
     "realism": {"enum": ["stand-in", "usable", "good"]},
     "license": {"allOf": [{"$ref": "#/$defs/safe"}, {"maxLength": 40}]},
     "descriptors": {
      "type": "object",
      "maxProperties": 12,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"oneOf": [{"allOf": [{"$ref": "#/$defs/safe"}, {"maxLength": 60}]}, {"type": "number", "minimum": -100000, "maximum": 100000}]}
     },
     "cycle": {"$ref": "#/$defs/curve"},
     "morph": {
      "type": "object",
      "required": ["frames"],
      "additionalProperties": false,
      "properties": {
       "frames": {
        "type": "array", "minItems": 2, "maxItems": 8,
        "items": {
         "type": "object", "required": ["pos", "points"], "additionalProperties": false,
         "properties": {"pos": {"type": "number", "minimum": 0, "maximum": 1}, "points": {"$ref": "#/$defs/points"}}
        }
       },
       "interp": {"enum": ["spectral", "linear"]},
       "out": {"type": "integer", "minimum": 2, "maximum": 64}
      }
     },
     "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "amp": {"$ref": "#/$defs/env"},
       "pitch": {"$ref": "#/$defs/env"},
       "filter": {"$ref": "#/$defs/env"}
      }
     },
     "registers": {
      "type": "array", "maxItems": 8,
      "items": {
       "type": "object", "required": ["from", "to"], "additionalProperties": false,
       "properties": {
        "from": {"type": "string", "pattern": "^[a-g][#bs]?-?[0-9]$"},
        "to": {"type": "string", "pattern": "^[a-g][#bs]?-?[0-9]$"},
        "use": {"enum": ["cycle", "morph"]},
        "gain": {"type": "number", "minimum": 0, "maximum": 2},
        "tilt": {"type": "number", "minimum": -12, "maximum": 12}
       }
      }
     },
     "params": {
      "type": "object", "maxProperties": 16,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
       "type": "object", "required": ["min", "max", "default"], "additionalProperties": false,
       "properties": {
        "min": {"type": "number", "minimum": -1000000, "maximum": 1000000},
        "max": {"type": "number", "minimum": -1000000, "maximum": 1000000},
        "default": {"type": "number", "minimum": -1000000, "maximum": 1000000},
        "to": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,15}$"},
        "unit": {"type": "string", "pattern": "^[a-z%]{0,8}$"}
       }
      }
     },
     "vary": {
      "type": "object", "additionalProperties": false,
      "properties": {
       "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
       "spread": {
        "type": "object", "maxProperties": 16,
        "propertyNames": {"$ref": "#/$defs/name"},
        "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
       }
      }
     }
    }
   }
  }
 },
 "$defs": {
  "safe": {"type": "string", "pattern": "^(?![ -~]*(?:[Dd][Aa][Tt][Aa]:|[Bb][Ll][Oo][Bb]:|://|[Bb][Aa][Ss][Ee]64|RIFF|RIFX))[ -~]*$"},
  "safe80": {"allOf": [{"$ref": "#/$defs/safe"}, {"maxLength": 80}]},
  "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$"},
  "points": {
   "type": "array", "minItems": 4, "maxItems": 256,
   "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -1, "maximum": 1}}
  },
  "curve": {
   "type": "object", "required": ["points"], "additionalProperties": false,
   "properties": {"points": {"$ref": "#/$defs/points"}, "interp": {"enum": ["spline", "linear"]}, "res": {"enum": [256, 512, 1024, 2048]}}
  },
  "env": {
   "type": "object", "required": ["points"], "additionalProperties": false,
   "properties": {
    "points": {
     "type": "array", "minItems": 2, "maxItems": 64,
     "items": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"anyOf": [{"type": "number", "minimum": -100, "maximum": 100}, {"enum": ["lin", "exp", "step", "hold"]}]}}
    },
    "adsr": {"type": "boolean"}
   }
  }
 }
}
