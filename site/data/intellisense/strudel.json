  {
   "label": "strudelCraft.capture.remake",
   "method": false,
   "detail": "remake(id) -> Promise<{match, sha256, expected}>",
   "info": "Regenerate a take from its recipe: approval modal, trust prompts, hash verification of every pinned ref (mismatch refuses), offline render, compare with the stored audio hash.",
   "category": "site api"
  },
  {
   "label": "strudelCraft.capture.webmSupported",
   "method": false,
   "detail": "webmSupported() -> mime | null",
   "info": "The WebM/opus mime type MediaRecorder can record here, or null (then realtime takes keep WAV only and the panel says so).",
   "category": "site api"
  },
  {
   "label": "strudelCraft.capture.beforeRender",
   "method": false,
   "detail": "beforeRender(async (recipe, { code }) => ...) -> unregister",
   "info": "Run an async hook before every offline render (exact render, reference render, Remake) with the recipe's program already compiled. The hook may call renderRecipe itself (nested renders skip hooks); a throwing hook aborts the render. Used by lanes captures to render cap_<name> audio first (#76).",
   "category": "site api"
  },
  {
   "label": "strudelCraft.capture.addTake",
   "method": false,
   "detail": "addTake({ name, L, R, sr, cps, cycles, from }) -> Promise<record>",
   "info": "Store an audio-only take (Float32Array L, R) in the take store, e.g. the bounce of a lane capture; recipe.meta.from names the source capture. Listed in the Record panel as 'from <name>', downloads as WAV.",
   "category": "site api"
  },
  {
   "label": "strudelCraft.capture.importRecipe",
   "method": false,
   "detail": "importRecipe(fileOrText)",
   "info": "Import a recipe JSON (version 1 only) as an inert take; nothing runs until Remake.",
