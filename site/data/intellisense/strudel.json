  {
   "label": "word",
   "detail": "word(\"<call me baby>\", bank='vox')",
   "info": "Word vocals: mini-notation of words -> s('vox_<word>'); 'baby:2' picks the 3rd take (n). Prelude #43.",
   "category": "vocals"
  },
  {
   "label": "syl",
   "detail": "syl(\"0 1 2\", bank='vox')",
   "info": "Syllables in lyric order: s('vox_syl').n(...). Prelude #43.",
   "category": "vocals"
  },
  {
   "label": "vowel",
   "detail": "vowel(\"a e i o u\")",
   "info": "Formant filter as a pattern function (works with word()).",
   "category": "vocals"
  },
  {
   "label": "formant",
   "method": true,
   "detail": "word(...).note(x).formant(true)",
   "info": "Pick the pre-rendered formant variant vox_<word>_f<semi> nearest to the note shift, fine-tune the residual (<= 50 cents) with speed. Needs a bank built with --formant-steps; otherwise plain note() retune plus one warning. #57",
   "category": "vocals"
  },
  {
   "label": "strudelCraft.palette.register",
   "method": false,
   "detail": "register({id, title, group, keys, run})",
   "info": "Add a command palette action (Ctrl+K). Returns an unregister function.",
   "category": "site api"
  },
  {
   "label": "strudelCraft.lanesUI.toggleTag",
   "method": false,
   "detail": "toggleTag(tag, 'mute' | 'solo') -> boolean",
   "info": "Graph view lane chips: add the statement tagged(\"tag\").mute() (or .solo()) to the graph program, or remove it when it is there. Same as a tag chip's Mute / Solo button.",
   "category": "site api"
  },
  {
   "label": "strudelCraft.lanesUI.setAmount",
   "method": false,
   "detail": "setAmount(bus, laneId, amount)",
   "info": "Graph view bus node: set one send amount (0..1). A lane's own .send(bus, x) is rewritten through applyOp literal; a group send rewrites that tagged(...).send(bus, x) argument.",
   "category": "site api"
  },
  {
   "label": "strudelCraft.lanesUI.countVoices",
   "method": false,
   "detail": "countVoices(lane) -> Promise<{ src, rd, layer }>",
   "info": "Graph view split fan: compile the lane alone (stops playback after asking) and count one cycle of events: source voices + bus readers, against source x branches for .layer.",
   "category": "site api"
  },
  {
   "label": "strudelCraft.lanesUI.state",
   "method": false,
   "detail": "state() -> { lanes, tags, chips, buses, captures, selections, refused, folded }",
   "info": "Graph view lanes projection: what the lane cards, bus / selection / capture nodes and the refused E_LANE_CROSS wires show (read-only; the model is the source).",
   "category": "site api"
  },
  {
   "label": "strudelCraft.copycode.copy",
   "method": false,
   "detail": "copy(target?, mode?) -> Promise<boolean>",
   "info": "Copy a code field: target 'rack' | 'stack' | a Syntax .sx-ex figure (default the visible editor); mode 'code' (whole CodeMirror doc) | 'selection' | 'link' | 'recipe'. Shows the Copied toast. Same as the copy button at each editor's top-right and Ctrl+K > Copy.",
   "category": "site api"
  },
  {
   "label": "strudelCraft.copycode.link",
   "method": false,
   "detail": "link(code) -> Promise<url>",
   "info": "A shareable URL with the code in its #code/ hash (deflate-raw + base64url, 'z' prefix; plain 'p' where CompressionStream is missing or does not help). Opening it loads the code into Rack. Rejects (LinkError, with a toast from copy()) code over limits.code = 256 KiB of UTF-8.",
   "category": "site api"
  },
  {
   "label": "strudelCraft.copycode.loadHash",
   "method": false,
   "detail": "loadHash(hash?) -> Promise<boolean>",
   "info": "Decode a #code/ link hash and load the code into the Rack editor (runs on page load and hash change). Never evaluates or plays it. Oversized (over 256 KiB decoded, payload length checked first, inflation capped while streaming), malformed, wrong-prefix, non-UTF-8 or empty payloads load nothing, leave the editor untouched and toast the reason; resolves false.",
   "category": "site api"
  },
  {
   "label": "strudelCraft.copycode.recipe",
   "method": false,
   "detail": "recipe(target?) -> Promise<json>",
   "info": "A recipe v1 JSON string (includes.code only) with the code, controls model, bound sites, Perform model and settings: the 'Copy with controls and state' payload.",
   "category": "site api"
  },
  {
   "label": "strudelCraft.pwa.install",
   "method": false,
   "detail": "install()",
   "info": "Install the site as an app (Android Chrome install prompt; elsewhere an Add to Home Screen hint in the site modal). Also in the ? dialog, the overflow menu and Ctrl+K > App. strudelCraft.pwa.installed / .standalone report the state. Installed, it loads and plays offline after the first visit (sw.js snapshot per deploy: site files, the Strudel bundle and CodeMirror); uncached sample banks toast.",
   "category": "site api"
  },
