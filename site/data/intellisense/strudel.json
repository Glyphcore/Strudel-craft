  },
  {
   "label": "strudelCraft.capture.download",
   "method": false,
   "detail": "download(id, 'recipe'|'wav16'|'wav24')",
   "info": "Download a take's recipe JSON or its audio as WAV.",
   "category": "site api"
  },
  {
   "label": "strudelCraft.recipe.verify",
   "method": false,
   "detail": "verify(recipe) -> {ok, refs, notes}",
   "info": "Fetch every pinned ref of a recipe and compare its sha256 (Strudel bundle, pack manifests, sample maps, vox banks).",
   "category": "site api"
  },
