{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "strudelcraft.model/1",
 "type": "object",
 "required": [
  "model"
 ],
 "additionalProperties": false,
 "properties": {
  "model": {
   "const": 1
  },
  "meta": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    },
    "kind": {
     "enum": [
      "song",
      "track",
      "set",
      "fragment",
      "bank",
      "performance",
      "board",
      "automation"
     ]
    },
    "rev": {
     "type": "integer",
     "minimum": 1
    },
    "hash": {
     "type": "string"
    },
    "parent": {
     "type": "string"
    },
    "tags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "settings": {
   "type": "object",
   "properties": {
    "lanes": { "enum": ["open", "closed"], "default": "open" },
    "cps": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "cpb": {
     "type": "number",
     "default": 1
    },
    "bpb": {
     "type": "integer",
     "default": 4
    }
   }
  },
  "header": {
   "type": "string",
   "description": "verbatim non-hook header code (setcpm, samples, helpers)"
  },
  "hookSrc": {
   "type": "array",
   "description": "verbatim hook statements with their position among the layers (at = number of tracks before it); re-emitted unchanged while they still describe the registry, canonical form otherwise",
   "items": {
    "type": "object",
    "required": ["at", "src"],
    "additionalProperties": false,
    "properties": { "at": { "type": "integer", "minimum": 0 }, "src": { "type": "string" } }
   }
  },
  "markers": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/point"
   }
  },
  "scopes": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "stem": {
      "type": "string"
     },
     "bus": {
      "type": "integer"
     }
    }
   }
  },
  "slots": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "mode": {
      "enum": [
       "chain",
       "swap",
       "stack"
      ]
     },
     "else": {
      "type": "string"
     },
     "quant": {
      "type": "number",
      "minimum": 0
     }
    }
   }
  },
  "defs": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/def"
   }
  },
  "vars": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "items": {
     "$ref": "#/$defs/assign"
    }
   }
  },
  "bindings": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/binding"
   }
  },
  "wires": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/wire"
   }
  },
  "tracks": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/track"
   }
  },
  "instances": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/instance"
   }
  },
  "components": {
   "type": "object",
   "description": "embedded component versions keyed name@rev, so the document is self-contained",
   "additionalProperties": {
    "$ref": "#"
   }
  },
  "exports": {
   "$ref": "#/$defs/exports"
  },
  "pads": {
   "type": "object",
   "properties": {
    "banks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/bank"
     }
    },
    "keymaps": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     }
    },
    "settings": {
     "type": "object",
     "properties": {
      "latencyMs": {
       "type": "number",
       "default": 0
      },
      "takeover": {
       "enum": [
        "pickup",
        "jump"
       ]
      },
      "activeKeymap": {
       "type": "object"
      }
     }
    }
   }
  },
  "controls": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/control"
   }
  },
  "maps": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/map"
   }
  },
  "boards": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/board"
   }
  },
  "automation": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/lane"
   }
  },
  "performances": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/performance"
   }
  },
  "journal": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "cycle",
     "op"
    ],
    "properties": {
     "cycle": {
      "type": "string"
     },
     "op": {
      "type": "string"
     },
     "args": {
      "type": "array"
     }
    }
   }
  },
  "layout": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "collapsed": {
      "type": "boolean"
     }
    }
   }
  },
  "atoms": {
   "type": "object",
   "description": "atoms (docs/ATOMS.md section 4), keyed by id",
   "additionalProperties": {
    "$ref": "#/$defs/atom"
   }
  },
  "buses": { "type": "object", "description": "named buses used by sends and returns (docs/LANES.md section 10); never bus numbers, those are allocated per compile and not data", "additionalProperties": { "type": "object", "properties": { "returns": { "type": "array", "items": { "type": "string" } } } } },
  "selections": { "type": "array", "items": { "$ref": "#/$defs/selection" } },
  "captures": { "type": "object", "additionalProperties": { "$ref": "#/$defs/capture" } }
 },
 "$defs": {
  "point": {
   "oneOf": [
    {
     "type": [
      "string",
      "number"
     ],
     "description": "HOOKS_SYNTAX gate point: 16, \"17b\", \"17.3b\", \"90s\", \"1:30\", \"drop-2b\""
    },
    {
     "$ref": "#/$defs/atomRef"
    }
   ]
  },
  "gate": {
   "oneOf": [
    {
     "type": "string"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "from": {
       "$ref": "#/$defs/point"
      },
      "until": {
       "$ref": "#/$defs/point"
      },
      "windows": {
       "type": "array"
      },
      "period": {
       "type": [
        "string",
        "number"
       ]
      },
      "when": {},
      "latch": {
       "type": "boolean"
      },
      "quant": {
       "type": "number",
       "minimum": 0
      },
      "unreached": {}
     }
    },
    {
     "$ref": "#/$defs/atomRef"
    }
   ]
  },
  "param": {
   "type": "object",
   "properties": {
    "min": {
     "type": "number"
    },
    "max": {
     "type": "number"
    },
    "default": {},
    "unit": {
     "type": "string"
    }
   }
  },
  "arg": {
   "description": "JSON literal, or {$param}, {$tap}, {$mini}, {$expr}, {$hook}, {$events}, {$curve}, {$atom}, {$code: 'arrow function text'}"
  },
  "step": {
   "type": "array",
   "prefixItems": [
    {
     "type": "string"
    }
   ],
   "items": {
    "$ref": "#/$defs/arg"
   },
   "minItems": 1
  },
  "def": {
   "type": "object",
   "properties": {
    "params": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/param"
     }
    },
    "taps": {
     "type": "object"
    },
    "decorator": {
     "type": "boolean"
    },
    "chain": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/step"
     }
    },
    "opaque": {
     "type": "boolean"
    },
    "src": {
     "type": "string"
    }
   }
  },
  "assign": {
   "type": "object",
   "required": [
    "value"
   ],
   "properties": {
    "value": {
     "$ref": "#/$defs/arg"
    },
    "gate": {
     "$ref": "#/$defs/gate"
    },
    "priority": {
     "type": "number"
    },
    "min": {
     "type": "number"
    },
    "max": {
     "type": "number"
    },
    "unit": {
     "type": "string"
    },
    "ns": {
     "type": "string"
    }
   }
  },
  "binding": {
   "type": "object",
   "required": [
    "slot",
    "hook"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "slot": {
     "oneOf": [
      {
       "type": "string"
      },
      {
       "$ref": "#/$defs/atomRef"
      }
     ]
    },
    "hook": {
     "oneOf": [
      {
       "type": "string"
      },
      {
       "$ref": "#/$defs/atomRef"
      }
     ]
    },
    "args": {
     "type": "object"
    },
    "gate": {
     "$ref": "#/$defs/gate"
    },
    "order": {
     "type": "number"
    },
    "priority": {
     "type": "number"
    },
    "else": {
     "oneOf": [
      {
       "type": "string"
      },
      {
       "$ref": "#/$defs/atomRef"
      }
     ]
    },
    "rebase": {
     "type": "boolean"
    }
   }
  },
  "wire": {
   "type": "object",
   "required": [
    "dest",
    "tap"
   ],
   "properties": {
    "dest": {
     "type": "string"
    },
    "tap": {
     "oneOf": [
      {
       "type": "string"
      },
      {
       "$ref": "#/$defs/atomRef"
      }
     ]
    },
    "range": {
     "type": "array"
    },
    "curve": {
     "enum": [
      "lin",
      "exp"
     ]
    },
    "op": {
     "enum": [
      "set",
      "add",
      "mul"
     ]
    },
    "gate": {
     "$ref": "#/$defs/gate"
    },
    "default": {}
   }
  },
  "track": {
   "type": "object",
   "required": [
    "name"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "ns": {
     "type": "string"
    },
    "stem": {
     "type": "string"
    },
    "bus": {
     "type": "integer"
    },
    "muted": {
     "type": "boolean"
    },
    "source": {
     "$ref": "#/$defs/step"
    },
    "chain": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/step"
     }
    },
    "src": {
     "type": "string",
     "description": "verbatim text; authoritative when chain is absent (opaque code node)"
    },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "static tags of the lane (`.tags(...)` with literal arguments on its chain); derived from the chain" },
    "split": { "$ref": "#/$defs/laneSplit" },
    "sends": { "type": "array", "items": { "$ref": "#/$defs/laneSend" } },
    "ret": { "type": "string", "description": "bus name this lane returns (`ret(name)` as its source)" }
   }
  },
  "laneBranch": {
   "type": "object", "required": ["id", "src"], "description": "one split branch callback: verbatim src and, when its body is a plain method chain on the parameter, the parsed chain (chain null otherwise)",
   "properties": { "id": { "type": "string" }, "src": { "type": "string" }, "param": { "type": ["string", "null"] }, "chain": { "type": ["array", "null"], "items": { "$ref": "#/$defs/step" } } }
  },
  "laneSplit": {
   "type": "object", "required": ["site", "at", "branches"], "description": "docs/LANES.md section 10: `.split(...)` of a lane; at = chain index of the split step; ids are first-sight path hashes (reconciled ids: engine/lanes-data.js laneSites)",
   "properties": { "site": { "type": "string" }, "at": { "type": "integer", "minimum": 0 }, "branches": { "type": "array", "items": { "$ref": "#/$defs/laneBranch" } },
     "merge": { "oneOf": [{ "const": true }, { "$ref": "#/$defs/laneBranch" }] }, "mix": { "type": "array", "items": { "type": "number" } }, "pre": { "type": "boolean" } }
  },
  "laneSend": {
   "type": "object", "required": ["bus"], "properties": { "bus": { "type": "string" }, "amount": { "type": "number", "minimum": 0, "maximum": 1 } }
  },
  "selection": {
   "type": "object", "required": ["selector", "ops"], "description": "a `tagged(selector).op()...` statement; ops use the shape the hooks runtime serialises (engine/lanes.js toJSON)",
   "properties": { "id": { "type": "string" }, "selector": { "type": ["string", "object"] }, "gate": {},
     "ops": { "type": "array", "items": { "type": "object", "required": ["op"], "properties": { "op": { "enum": ["fx", "send", "mute", "solo", "gain", "orbit", "capture"] } } } } }
  },
  "capture": {
   "type": "object", "required": ["picker"], "description": "capture(name, picker, opts): the name is the key; picker is a selector string, a tap ref, bus:<name> or master",
   "properties": { "picker": { "type": ["string", "object"] }, "window": { "type": ["string", "object"] }, "last": { "type": ["string", "number"] },
     "what": { "type": "array", "items": { "enum": ["events", "audio", "level"] } }, "live": { "type": ["boolean", "string"] }, "max": { "type": ["string", "number"] } }
  },
  "instance": {
   "type": "object",
   "required": [
    "component",
    "as"
   ],
   "properties": {
    "component": {
     "type": "string",
     "pattern": "^[A-Za-z][\\w-]*@[0-9]+$"
    },
    "as": {
     "type": "string"
    },
    "args": {
     "type": "object"
    },
    "gate": {
     "$ref": "#/$defs/gate"
    },
    "remap": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    }
   }
  },
  "bank": {
   "type": "object",
   "required": [
    "id",
    "rows",
    "cols"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "rows": {
     "type": "integer",
     "minimum": 1,
     "maximum": 8
    },
    "cols": {
     "type": "integer",
     "minimum": 1,
     "maximum": 8
    },
    "scenes": {
     "enum": [
      "none",
      "row",
      "col"
     ]
    },
    "sceneQuant": {},
    "sceneStopsEmpty": {
     "type": "boolean"
    },
    "pads": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/pad"
     }
    }
   }
  },
  "pad": {
   "type": "object",
   "required": [
    "pos",
    "target"
   ],
   "properties": {
    "pos": {
     "type": "string",
     "pattern": "^[0-7],[0-7]$"
    },
    "target": {
     "type": "object",
     "required": [
      "kind",
      "ref"
     ],
     "properties": {
      "kind": {
       "enum": [
        "component",
        "hook",
        "var",
        "tap",
        "scene",
        "action",
        "selection"
       ]
      },
      "op": {
       "enum": [
        "mute",
        "solo"
       ],
       "description": "kind selection: which toggle of the tagged(...) statement the pad drives; ref is its AST site id"
      },
      "ref": {
       "oneOf": [
        {
         "type": "string"
        },
        {
         "$ref": "#/$defs/atomRef"
        }
       ]
      },
      "slot": {
       "type": "string"
      },
      "value": {
       "$ref": "#/$defs/arg"
      }
     }
    },
    "mode": {
     "enum": [
      "oneshot",
      "gate",
      "toggle",
      "retrigger"
     ]
    },
    "quant": {
     "type": [
      "string",
      "number"
     ]
    },
    "offQuant": {
     "type": [
      "string",
      "number"
     ]
    },
    "length": {
     "type": [
      "string",
      "number"
     ]
    },
    "choke": {
     "type": "integer"
    },
    "colour": {
     "type": "string"
    },
    "label": {
     "type": "string",
     "maxLength": 12
    },
    "args": {
     "type": "object"
    },
    "velocity": {}
   }
  },
  "performance": {
   "type": "object",
   "required": [
    "length",
    "layers"
   ],
   "properties": {
    "length": {
     "type": "string"
    },
    "origin": {
     "type": "string"
    },
    "until": {
     "type": "string"
    },
    "bank": {
     "type": "string"
    },
    "layers": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "events": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "t",
          "pad",
          "type"
         ],
         "properties": {
          "t": {
           "type": "string"
          },
          "pad": {
           "type": "string"
          },
          "type": {
           "enum": [
            "on",
            "off"
           ]
          },
          "velocity": {
           "type": "number",
           "minimum": 0,
           "maximum": 1
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "control": {
   "type": "object",
   "required": [
    "type"
   ],
   "properties": {
    "type": {
     "type": "string",
     "description": "id in the control type registry"
    },
    "min": {
     "type": "number"
    },
    "max": {
     "type": "number"
    },
    "default": {},
    "value": {},
    "step": {
     "type": "number",
     "minimum": 0
    },
    "curve": {
     "enum": [
      "lin",
      "exp",
      "log",
      "db",
      "bipolar"
     ]
    },
    "unit": {
     "type": "string"
    },
    "smooth": {
     "type": "number",
     "minimum": 0
    },
    "axes": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/param"
     }
    },
    "options": {
     "type": "array"
    },
    "count": {
     "type": "integer",
     "minimum": 1,
     "maximum": 64
    },
    "per": {
     "type": [
      "string",
      "number"
     ]
    },
    "ns": {
     "type": "string"
    },
    "label": {
     "type": "string"
    },
    "colour": {
     "type": "string"
    },
    "render": {
     "type": "object"
    }
   }
  },
  "map": {
   "type": "object",
   "required": [
    "control",
    "dest"
   ],
   "properties": {
    "control": {
     "type": "string"
    },
    "dest": {
     "oneOf": [
      {
       "type": "string"
      },
      {
       "$ref": "#/$defs/atomRef"
      }
     ]
    },
    "range": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2
    },
    "curve": {
     "enum": [
      "lin",
      "exp",
      "log",
      "db",
      "bipolar"
     ]
    },
    "op": {
     "enum": [
      "set",
      "add",
      "mul"
     ]
    },
    "gate": {
     "$ref": "#/$defs/gate"
    },
    "priority": {
     "type": "number"
    }
   }
  },
  "board": {
   "type": "object",
   "required": [
    "id"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "layouts": {
     "type": "object",
     "description": "keyed by column count, e.g. \"4\", \"12\"",
     "additionalProperties": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "ref",
        "x",
        "y"
       ],
       "properties": {
        "ref": {
         "type": "string",
         "pattern": "^(ctl|pad|meter):"
        },
        "x": {
         "type": "integer"
        },
        "y": {
         "type": "integer"
        },
        "w": {
         "type": "integer",
         "minimum": 1
        },
        "h": {
         "type": "integer",
         "minimum": 1
        }
       }
      }
     }
    }
   }
  },
  "lane": {
   "type": "object",
   "required": [
    "control",
    "points"
   ],
   "properties": {
    "control": {
     "type": "string"
    },
    "length": {
     "type": "string"
    },
    "period": {
     "type": [
      "string",
      "number"
     ]
    },
    "mode": {
     "enum": [
      "curve",
      "steps"
     ]
    },
    "absolute": {
     "type": "boolean"
    },
    "priority": {
     "type": "number"
    },
    "gate": {
     "$ref": "#/$defs/gate"
    },
    "points": {
     "type": "array",
     "items": {
      "type": "array",
      "prefixItems": [
       {
        "type": "string"
       },
       {},
       {
        "enum": [
         "hold",
         "lin",
         "exp"
        ]
       }
      ],
      "minItems": 2
     }
    }
   }
  },
  "exports": {
   "type": "object",
   "properties": {
    "params": {
     "type": "object",
     "additionalProperties": {
      "allOf": [
       {
        "$ref": "#/$defs/param"
       }
      ],
      "properties": {
       "target": {
        "type": "string"
       }
      }
     }
    },
    "taps": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "slots": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "hooks": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "requires": {
     "type": "object",
     "properties": {
      "taps": {
       "type": "array"
      },
      "markers": {
       "type": "array"
      }
     }
    }
   }
  },
  "atom": {
   "type": "object",
   "required": [
    "name",
    "type"
   ],
   "additionalProperties": false,
   "properties": {
    "name": {
     "type": "string",
     "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "type": {
     "type": "string",
     "description": "id in the atom type registry"
    },
    "params": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/atomParam"
     }
    },
    "body": {
     "description": "string with ${param} holes, or object, or composition node ($seq $stack $alt $rep $slow $euclid $union $shift $atom $param)"
    },
    "from": {
     "type": "object",
     "required": [
      "atom"
     ],
     "properties": {
      "atom": {
       "type": "string"
      },
      "args": {
       "type": "object"
      },
      "ops": {
       "type": "array",
       "items": {
        "type": "array"
       }
      }
     }
    },
    "rev": {
     "type": "integer",
     "minimum": 1
    },
    "hash": {
     "type": "string"
    },
    "parent": {
     "type": "string"
    },
    "doc": {
     "type": "string"
    },
    "tags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "oneOf": [
    {
     "required": [
      "body"
     ]
    },
    {
     "required": [
      "from"
     ]
    }
   ]
  },
  "atomParam": {
   "type": "object",
   "required": [
    "shape"
   ],
   "properties": {
    "shape": {
     "type": "string",
     "description": "number | enum | bool | note | sound | mini | name | atom:<type>"
    },
    "min": {
     "type": "number"
    },
    "max": {
     "type": "number"
    },
    "step": {
     "type": "number"
    },
    "unit": {
     "type": "string"
    },
    "curve": {
     "enum": [
      "lin",
      "exp",
      "log",
      "db",
      "bipolar"
     ]
    },
    "options": {
     "type": "array"
    },
    "default": {}
   }
  },
  "atomRef": {
   "type": "object",
   "required": [
    "$atom"
   ],
   "additionalProperties": false,
   "properties": {
    "$atom": {
     "type": "string",
     "description": "atom id, or catalog ref such as snd:bd"
    },
    "args": {
     "type": "object"
    },
    "ops": {
     "type": "array",
     "description": "composition ops applied at the use site, in order: [[\"after\"], [\"shift\", \"2b\"]]",
     "items": {
      "type": "array"
     }
    }
   }
  }
 }
}