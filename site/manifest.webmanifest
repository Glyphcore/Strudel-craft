{
  "id": "./",
  "name": "Strudel Craft",
  "short_name": "Strudel Craft",
  "description": "A playable instrument of Strudel recipes: browse sounds by what they do, audition them live with scope, spectrum and pattern lanes, stack them into one program.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#0b0d10",
  "background_color": "#0b0d10",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Rack", "short_name": "Rack", "description": "Browse and audition recipes", "url": "./#rack", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Stack", "short_name": "Stack", "description": "Layer recipes into one program", "url": "./#stack", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Record", "short_name": "Record", "description": "Open audio capture", "url": "./?action=record#rack", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Perform", "short_name": "Perform", "description": "Pads, lanes and control boards", "url": "./#perform", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "file_handlers": [
    { "action": "./?action=open-file", "accept": { "application/json": [".json"] } }
  ]
}
