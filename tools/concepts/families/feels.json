{
 "family": "feels",
 "title": "Feel templates",
 "doc": "A feel fills the template slots drums (kick, snare, perc), top (hats, top), bass, harmony, fx and groove. Each feel is one atoms@1 ingredient with the same atom names, so a track picks a feel with one import line (atoms.import(\"pack:glyphcore/phonk:feel-<id>\", { as: \"feel\" })) and overrides a slot by binding something else into it.",
 "template": {
  "voices": [
   "kick",
   "snare",
   "perc",
   "hats",
   "top",
   "bass",
   "harmony",
   "fx"
  ],
  "slots": {
   "drums": [
    "kick",
    "snare",
    "perc"
   ],
   "top": [
    "hats",
    "top"
   ],
   "bass": [
    "bass"
   ],
   "harmony": [
    "harmony"
   ],
   "fx": [
    "fx"
   ],
   "groove": []
  },
  "src": {
   "kick": "s",
   "snare": "s",
   "perc": "s",
   "hats": "s",
   "top": "note",
   "bass": "note",
   "harmony": "note",
   "fx": "s"
  }
 },
 "feels": {
  "boombap": {
